# Market Lens Environment Configuration
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/market_lens

# -----------------------------------------------------------------------------
# SEC EDGAR (REQUIRED - must include your email per SEC policy)
# -----------------------------------------------------------------------------
EDGAR_USER_AGENT=Market Lens Research your_email@example.com

# -----------------------------------------------------------------------------
# API Keys (Free tier keys - get from respective websites)
# -----------------------------------------------------------------------------

# FRED (Federal Reserve Economic Data) - free from fred.stlouisfed.org
FRED_API_KEY=your_fred_api_key_here

# NewsAPI - free tier from newsapi.org (100 requests/day)
NEWSAPI_KEY=your_newsapi_key_here

# Tradier - free developer account from developer.tradier.com
TRADIER_ACCESS_TOKEN=your_tradier_token_here

# Barchart - free tier from barchart.com/cmdtyview
BARCHART_API_KEY=your_barchart_key_here

# Alpha Vantage - free tier from alphavantage.co (25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# Anthropic Claude API - paid but low cost ($2-8/month for personal use)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Congress.gov API - free from api.congress.gov
CONGRESS_API_KEY=your_congress_api_key_here

# USPTO API - free from developer.uspto.gov
USPTO_API_KEY=your_uspto_key_here

# Financial Modeling Prep - free tier from financialmodelingprep.com
FMP_API_KEY=your_fmp_key_here

# -----------------------------------------------------------------------------
# Alerts
# -----------------------------------------------------------------------------

# Telegram Bot (free - create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=your_email@gmail.com

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
STREAMLIT_PORT=8501
DASHBOARD_BASE_URL=http://localhost:8501

# -----------------------------------------------------------------------------
# Paths & Logging (optional overrides)
# -----------------------------------------------------------------------------
# MARKET_LENS_LOG_DIR=C:\path\to\logs
# MARKET_LENS_LOG_MAX_BYTES=10485760
# MARKET_LENS_LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Timezone (display only - internal is always UTC)
# -----------------------------------------------------------------------------
DISPLAY_TIMEZONE=America/New_York
